# ─────────────────────────────────────────────────────────────────────
# Plataforma de Atención Ciudadana — variables de entorno
# Copia este archivo a `.env` y llena los valores.
# Los marcados [PENDIENTE] traen valores demo: ver PENDIENTES.md
# ─────────────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://USUARIO@localhost:5432/atencion_ciudadana?schema=public"

# ── Identidad del municipio ──────────────────────────────────────────
# Estos valores solo se usan la PRIMERA vez, para sembrar la configuración.
# Después se edita todo en /admin/municipio y esto deja de leerse.
MUNICIPIO_NOMBRE="Tula de Allende"
MUNICIPIO_PREFIJO_FOLIO="TUL"
MUNICIPIO_CENTRO_LAT="20.0517"
MUNICIPIO_CENTRO_LNG="-99.3450"
MUNICIPIO_ZOOM_INICIAL="14"
TEL_EMERGENCIAS="911"

# El huso horario NO se edita desde la interfaz: define qué es un día hábil, y
# cambiarlo reinterpretaría la fecha límite de todos los reportes existentes.
MUNICIPIO_TZ="America/Mexico_City"


# Muestra un aviso de "datos ficticios" en todas las páginas. Enciéndelo en
# cualquier instalación sembrada con el seed: publicar cifras inventadas a
# nombre de un municipio real, sin decirlo, es engañoso.
MODO_DEMO="true"

# ── Seguridad ────────────────────────────────────────────────────────
# Firma de la sesión httpOnly. Generar con: openssl rand -base64 32
AUTH_SECRET=""
# Cifrado en reposo de teléfonos (AES-256-GCM). openssl rand -base64 32
# CORRECCIÓN C-05: el SPEC pide teléfonos cifrados pero no declara esta llave.
PHONE_ENCRYPTION_KEY=""
# Protege los endpoints /api/cron/*. openssl rand -base64 32
# CORRECCIÓN C-07: el SPEC exige autocierre a 3 días y agregados cada 15 min,
# sin definir quién los dispara.
CRON_SECRET=""

# ── IA (clasificador del bot) ────────────────────────────────────────
# Opcional. Sin llave, el bot cae al menú de categorías (SPEC §4.1, criterio 2).
ANTHROPIC_API_KEY=""
# CORRECCIÓN C-08: el SPEC pide `claude-sonnet-4-6`, que ya no existe.
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Mensajería (WhatsApp) ────────────────────────────────────────────
# simulador | whatsapp_cloud
MESSAGING_DRIVER="simulador"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ── Bot de Telegram ──────────────────────────────────────────────────
# El token lo da @BotFather. El secreto lo eliges tú y se registra con
# setWebhook: Telegram no firma sus webhooks, así que es la única protección
# contra que cualquiera que adivine la URL inyecte conversaciones.
# Ambos los llena ./scripts/telegram-conectar.sh; no hace falta editarlos a mano.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Solo para desarrollo con túnel: el host público que ngrok te da, sin protocolo.
# Sin esto, Next 16 rechaza las peticiones que no vengan de localhost.
DEV_ORIGENES_PERMITIDOS=""

# Dominio público del sitio (https://demosvoz.com). Telegram lo necesita para
# descargar las fotos de evidencia que se le mandan al ciudadano: una ruta como
# /uploads/... no le dice nada a sus servidores.
# En desarrollo lo llena solo `npm run telegram` con la URL del túnel.
SITIO_URL=""

# ── Almacenamiento de imágenes ───────────────────────────────────────
# local | s3
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Correo de las alertas internas (opcional) ────────────────────────
# Sin esto, las alertas igual se detectan y se ven en el tablero interno;
# solo no salen por correo.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SEGURO="false"
SMTP_USUARIO=""
SMTP_PASSWORD=""
SMTP_FROM="Atención Ciudadana <no-responder@municipio.gob.mx>"
# Separados por coma: a quién le llegan las alertas.
ALERTAS_DESTINATARIOS=""

# ── Umbrales de alertas internas (SPEC §4.5) ─────────────────────────
ALERTA_VENCIDOS_PCT="20"
ALERTA_CAIDA_CALIFICACION="0.5"
ALERTA_REAPERTURAS_CATEGORIA="3"

# Radio de detección de duplicados, en metros (SPEC §4.2)
DUPLICADOS_RADIO_METROS="100"
DUPLICADOS_VENTANA_DIAS="30"
