# ─────────────────────────────────────────────────────────────────────
# Plataforma de Atención Ciudadana — variables de entorno
# Copia este archivo a `.env` y llena los valores.
# Los marcados [PENDIENTE] traen valores demo: ver PENDIENTES.md
# ─────────────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://USUARIO@localhost:5432/atencion_ciudadana?schema=public"

# ── Identidad del municipio ──────────────────────────────────────────
# [PENDIENTE] Sustituir por los datos reales del municipio.
MUNICIPIO_NOMBRE="Municipio Demo"
MUNICIPIO_PREFIJO_FOLIO="MUN"
MUNICIPIO_TZ="America/Mexico_City"
MUNICIPIO_CENTRO_LAT="19.4326"
MUNICIPIO_CENTRO_LNG="-99.1332"
MUNICIPIO_ZOOM_INICIAL="13"
TEL_EMERGENCIAS="911"

# Espejo público de los valores anteriores (los usa el mapa en el navegador).
NEXT_PUBLIC_MUNICIPIO_NOMBRE="Municipio Demo"
NEXT_PUBLIC_MUNICIPIO_CENTRO_LAT="19.4326"
NEXT_PUBLIC_MUNICIPIO_CENTRO_LNG="-99.1332"
NEXT_PUBLIC_MUNICIPIO_ZOOM_INICIAL="13"
NEXT_PUBLIC_TEL_EMERGENCIAS="911"

# ── Seguridad ────────────────────────────────────────────────────────
# Firma de la sesión httpOnly. Generar con: openssl rand -base64 32
AUTH_SECRET=""
# Cifrado en reposo de teléfonos (AES-256-GCM). openssl rand -base64 32
# CORRECCIÓN C-05: el SPEC pide teléfonos cifrados pero no declara esta llave.
PHONE_ENCRYPTION_KEY=""
# Protege los endpoints /api/cron/*. openssl rand -base64 32
# CORRECCIÓN C-07: el SPEC exige autocierre a 3 días y agregados cada 15 min,
# sin definir quién los dispara.
CRON_SECRET=""

# ── IA (clasificador del bot) ────────────────────────────────────────
# Opcional. Sin llave, el bot cae al menú de categorías (SPEC §4.1, criterio 2).
ANTHROPIC_API_KEY=""
# CORRECCIÓN C-08: el SPEC pide `claude-sonnet-4-6`, que ya no existe.
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Mensajería (WhatsApp) ────────────────────────────────────────────
# simulador | whatsapp_cloud
MESSAGING_DRIVER="simulador"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ── Almacenamiento de imágenes ───────────────────────────────────────
# local | s3
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Umbrales de alertas internas (SPEC §4.5) ─────────────────────────
ALERTA_VENCIDOS_PCT="20"
ALERTA_CAIDA_CALIFICACION="0.5"
ALERTA_REAPERTURAS_CATEGORIA="3"

# Radio de detección de duplicados, en metros (SPEC §4.2)
DUPLICADOS_RADIO_METROS="100"
DUPLICADOS_VENTANA_DIAS="30"
